{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Token Monitor",
  "version": "0.1.0",
  "identifier": "com.afonseca013.tray-usage-monitor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Uso de IA",
        "url": "tray-popup.html",
        "width": 340,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Configurações",
        "url": "settings.html",
        "width": 480,
        "height": 420,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
